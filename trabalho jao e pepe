# Lista de produtos pré-cadastrados
produtos = [
    {
        "codigo": 101,
        "nome": "Notebook",
        "preco": 3500.00,
        "quantidade": 10
    },
    {
        "codigo": 102,
        "nome": "Mouse",
        "preco": 80.00,
        "quantidade": 25
    },
    {
        "codigo": 103,
        "nome": "Teclado",
        "preco": 150.00,
        "quantidade": 15
    }
]


# Função para exibir o menu
def exibir_menu():
    print("\n===== SISTEMA DE ESTOQUE =====")
    print("1 - Cadastrar produto")
    print("2 - Listar produtos")
    print("3 - Buscar produto")
    print("4 - Remover produto")
    print("5 - Sair")


# Função para cadastrar produtos
def cadastrar(lista):
    print("\n--- CADASTRAR PRODUTO ---")

    try:
        codigo = int(input("Digite o código do produto: "))

        # Verifica se o código já existe
        for produto in lista:
            if produto["codigo"] == codigo:
                print("Esse código já está cadastrado!")
                return

        nome = input("Digite o nome do produto: ").strip()

        if nome == "":
            print("O nome não pode ficar vazio!")
            return

        preco = float(input("Digite o preço do produto: "))
        quantidade = int(input("Digite a quantidade: "))

        if preco < 0 or quantidade < 0:
            print("Preço e quantidade não podem ser negativos!")
            return

        novo_produto = {
            "codigo": codigo,
            "nome": nome,
            "preco": preco,
            "quantidade": quantidade
        }

        lista.append(novo_produto)

        print("Produto cadastrado com sucesso!")

    except ValueError:
        print("Erro! Digite números válidos nos campos numéricos.")


# Função para listar produtos
def listar(lista):
    print("\n--- LISTA DE PRODUTOS ---")

    if len(lista) == 0:
        print("Não existem produtos cadastrados.")
        return

    for produto in lista:
        print("-------------------------")
        print("Código:", produto["codigo"])
        print("Nome:", produto["nome"])
        print("Preço: R$", produto["preco"])
        print("Quantidade:", produto["quantidade"])


# Função para buscar produtos (busca sequencial)
def buscar(lista):
    print("\n--- BUSCAR PRODUTO ---")

    try:
        codigo = int(input("Digite o código do produto: "))

        encontrado = False
        comparacoes = 0

        for produto in lista:
            comparacoes += 1

            if produto["codigo"] == codigo:
                print("\nProduto encontrado!")
                print("Código:", produto["codigo"])
                print("Nome:", produto["nome"])
                print("Preço: R$", produto["preco"])
                print("Quantidade:", produto["quantidade"])

                encontrado = True
                break

        if encontrado == False:
            print("Produto não encontrado!")

        print("Comparações realizadas:", comparacoes)

    except ValueError:
        print("Digite um código numérico válido!")


# Função para remover produtos
def remover(lista):
    print("\n--- REMOVER PRODUTO ---")

    if len(lista) == 0:
        print("Não existem produtos para remover.")
        return

    try:
        codigo = int(input("Digite o código do produto que deseja remover: "))

        for i in range(len(lista)):
            if lista[i]["codigo"] == codigo:
                produto_removido = lista.pop(i)
                print("Produto", produto_removido["nome"], "removido com sucesso!")
                return

        print("Produto não encontrado!")

    except ValueError:
        print("Digite um código numérico válido!")


# Programa principal
while True:
    exibir_menu()

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        cadastrar(produtos)

    elif opcao == "2":
        listar(produtos)

    elif opcao == "3":
        buscar(produtos)

    elif opcao == "4":
        remover(produtos)

    elif opcao == "5":
        print("Sistema encerrado. Obrigado!")
        break

    else:
        print("Opção inválida! Escolha de 1 a 5.")
